# Omarchy Vault — runs as YOUR user (systemctl --user), never as root.
# Installed to ~/.config/systemd/user/ by scripts/install.sh.
[Unit]
Description=Omarchy Vault (private cloud dashboard and API)
Documentation=https://github.com/TouchWorkStation/Omarchy-Vault
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vaultd
Restart=on-failure
RestartSec=3

# Binds to 127.0.0.1:8788 by default (see config.json "listen").
# Hardening that works for user services:
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

# vaultd idles around 10-15 MB and the file service (SFTPGo, a child
# process) around 40-60 MB. Caps catch leaks without hurting big uploads.
MemoryHigh=300M
MemoryMax=512M
# Stop the file service together with Vault.
KillMode=control-group

[Install]
WantedBy=default.target
