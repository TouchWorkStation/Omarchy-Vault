{
  "$comment": "Omarchy Vault desktop integration. Independent of Beam. Vault runs only when turned on: the widget shows OFF and never starts it by itself.",
  "id": "omarchy-vault",
  "name": "Omarchy Vault",
  "version": "0.1.0",
  "api": "http://127.0.0.1:8788/api/status",
  "widget": "qml/VaultStatusWidget.qml",
  "panel": "qml/VaultPanel.qml",
  "actions": [
    {
      "id": "power",
      "label": "Turn on / off",
      "command_on": [
        "vaultctl",
        "on"
      ],
      "command_off": [
        "vaultctl",
        "off"
      ],
      "milestone": 3
    },
    {
      "id": "upload",
      "label": "Upload",
      "detail": "Phone → Vault",
      "command": [
        "vaultctl",
        "upload"
      ],
      "milestone": 4
    },
    {
      "id": "download",
      "label": "Download",
      "detail": "Vault → Phone",
      "command": [
        "vaultctl",
        "download"
      ],
      "milestone": 5
    },
    {
      "id": "files",
      "label": "Open Files",
      "command": [
        "vaultctl",
        "open"
      ],
      "milestone": 3
    },
    {
      "id": "storage",
      "label": "Storage",
      "command": [
        "xdg-open",
        "http://127.0.0.1:8788/storage"
      ],
      "milestone": 1
    },
    {
      "id": "remote",
      "label": "Remote Access",
      "command": [
        "xdg-open",
        "http://127.0.0.1:8788/remote"
      ],
      "milestone": 6
    }
  ],
  "shortcuts": [
    {
      "id": "open",
      "combo": "SUPER SHIFT, V",
      "label": "Open Vault",
      "command": "vaultctl open"
    },
    {
      "id": "upload",
      "combo": "SUPER SHIFT, U",
      "label": "Upload to Vault",
      "command": "vaultctl upload"
    },
    {
      "id": "download",
      "combo": "SUPER SHIFT, D",
      "label": "Download from Vault",
      "command": "vaultctl download"
    }
  ],
  "shortcutPolicy": "check-then-ask: never overwrite an existing binding (see docs/shortcuts.md)"
}
